# Server Port (Render sets PORT automatically, but fallback is 5000)
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Option 1: Individual Cloud MySQL connection parameters
DB_HOST=your-mysql-cloud-host.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=sas_db
DB_SSL=true

# Option 2: Full Connection String (if provided by your cloud MySQL provider)
# DATABASE_URL=mysql://user:password@host:port/database_name?sslMode=REQUIRED
